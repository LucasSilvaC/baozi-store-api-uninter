      "name": "1. Criar cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cliente = pm.response.json();",
              "pm.collectionVariables.set('clienteId', cliente.id);",
              "pm.test(\"status esperado: 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"resposta cont?m identificador\", () => pm.expect(pm.response.json().id).to.exist);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{nomeCliente}}\",\n  \"clienteDesde\": \"{{clienteDesde}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "clientes"
          ]
